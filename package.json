{
  "name": "lockin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "watch": "concurrently -k -n server,build -c blue,yellow \"tsx watch server/index.ts\" \"vite build --watch\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@hono/node-server": "^1.13.7",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "satori": "^0.12.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
